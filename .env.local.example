# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (metadata, sitemap, robots, Paymob callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — service role key. SERVER ONLY.
# Never import this into client components or expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paymob — card payments
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-paymob-integration-id
PAYMOB_IFRAME_ID=your-paymob-iframe-id
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
